{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BudgetLoop",
  "version": "0.3.0",
  "identifier": "cn.versecraft.budgetloop.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BudgetLoop",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:3000 http://localhost:8000; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["msi"],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
