# ===== BudgetLoop 环境变量示例 =====
# 复制为 .env 后填写。禁止在代码中硬编码任何密钥。

# --- 默认 AI API 网关：QuantumNous/new-api v1.0.0-rc.21 ---
# 首次启动后访问 http://localhost:3001，在 New API 控制台配置合法上游、
# `budgetloop-recommendation` 模型别名和网关 Token。上游 Key 只保存在 New API。
AI_GATEWAY_TYPE=new-api
AI_GATEWAY_BASE_URL=http://new-api:3000
AI_GATEWAY_CONSOLE_URL=http://localhost:3001
AI_GATEWAY_API_KEY=replace-with-new-api-token
AI_GATEWAY_RECOMMENDATION_MODEL=budgetloop-recommendation
AI_GATEWAY_DEFAULT_MODEL=
AI_GATEWAY_DEPLOYMENT_LABEL=
AI_GATEWAY_NETWORK_LABEL=
AI_GATEWAY_REASONING_EFFORT=
AI_GATEWAY_THINKING_ENABLED=false
AI_GATEWAY_THINKING_BUDGET_TOKENS=0
AI_RECOMMENDATION_ENABLED=true
AI_GATEWAY_CONNECT_TIMEOUT_SECONDS=2
AI_GATEWAY_READ_TIMEOUT_SECONDS=8
MANAGED_AI_RUNTIME_ENABLED=true
MANAGED_AI_RUNTIME_BASE_URL=http://127.0.0.1:8000/api/runtime/ai/v1
MANAGED_AI_RUNTIME_CONTAINER_BASE_URL=http://host.docker.internal:8000/api/runtime/ai/v1
CONTROL_PLANE_HOST_PORT=18080
NEW_API_PORT=3001
NEW_API_SESSION_SECRET=replace-with-long-random-session-secret

# New API 支持 OpenAI Chat/Responses、Claude Messages、Gemini 与自定义授权上游，
# 协议转换、渠道优先级/权重、重试和限流均由 New API 负责，BudgetLoop 不重写。

# --- LiteLLM Proxy（仅旧部署兼容：docker compose --profile legacy-litellm） ---
# 使用时设置 AI_GATEWAY_TYPE=litellm，并把 AI_GATEWAY_* 指向 LiteLLM；
# 下列旧变量继续兼容，但不会与 New API 串联。
LITELLM_MASTER_KEY=sk-litellm-master-change-me
LITELLM_SALT_KEY=sk-litellm-salt-change-me
LITELLM_PORT=4000
LLM_API_KEY=sk-your-real-provider-key
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# --- PostgreSQL ---
POSTGRES_USER=budgetloop
POSTGRES_PASSWORD=budgetloop-change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# 业务库（唯一业务事实来源）
DATABASE_URL=postgresql://budgetloop:budgetloop-change-me@postgres:5432/budgetloop
# LiteLLM 自身的库（spend logs / virtual keys）
LITELLM_DATABASE_URL=postgresql://budgetloop:budgetloop-change-me@postgres:5432/litellm

# --- Valkey / Redis ---
REDIS_URL=redis://valkey:6379/0

# --- Control Plane ---
CONTROL_PLANE_PORT=8000
# 前端访问 API 的静态令牌（演示级 auth）
API_TOKEN=budgetloop-dev-token

# --- Worker ---
# OpenHands agent-server 镜像（每 task_run 一个 Workspace 容器）
AGENT_SERVER_IMAGE=ghcr.io/openhands/agent-server:latest-python
# CLI 引擎须先在 worker 镜像安装对应命令；默认关闭，避免静默误用宿主环境。
ENABLE_CLI_ENGINES=true
# CLI run/worktree 与引擎状态均隔离到独立目录。
# macOS 启动器会动态注入 repoRoot 下的宿主绝对路径，供 sibling sandbox 挂载。
# 仅手工启动 Compose 时才需要取消注释并填写当前仓库的绝对路径。
# CLI_WORKSPACE_ROOT=/absolute/path/to/BudgetLoop/.budgetloop/workspaces/cli
# CLI_ENGINE_STATE_ROOT=/absolute/path/to/BudgetLoop/.budgetloop/engine-state
# 每个引擎必须显式提供独立 HOME 或独立环境变量；不会继承其他引擎的 Key。
# BUDGETLOOP_CODEX_HOME=/data/engine-home/codex
# BUDGETLOOP_CODEX_ENV_OPENAI_API_KEY=...
# BUDGETLOOP_GEMINI_CLI_HOME=/data/engine-home/gemini-cli
# BUDGETLOOP_GEMINI_CLI_ENV_GEMINI_API_KEY=...
BUDGETLOOP_GEMINI_CLI_SANDBOX_READY=true
# Gemini 官方 Docker sandbox 使用本地固定 worker 镜像，避免运行时拉取。
GEMINI_SANDBOX_IMAGE=budgetloop-worker:latest
# OpenCode 无内置进程沙箱，必须配置外层 sandbox 命令；宿主执行只能显式选择。
# BUDGETLOOP_OPENCODE_SANDBOX_COMMAND=sandbox-exec -f /etc/budgetloop/opencode.sb
# BUDGETLOOP_OPENCODE_ALLOW_HOST_EXECUTION=false
# 工件存储：local | minio
ARTIFACT_BACKEND=local
ARTIFACT_LOCAL_DIR=/data/artifacts

# --- MinIO（ARTIFACT_BACKEND=minio 时） ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin-change-me
MINIO_BUCKET=budgetloop-artifacts

# --- Web ---
WEB_PORT=3000
# 浏览器默认请求同源 /api/control；Next.js 服务端再向控制面注入 API_TOKEN。
CONTROL_PLANE_API_BASE=http://control-plane:8000
CONTROL_PLANE_API_TOKEN=budgetloop-dev-token

# --- 观测（可选，compose profile=observability） ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
